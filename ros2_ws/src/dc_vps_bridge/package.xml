<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dc_vps_bridge</name>
  <version>0.1.0</version>
  <description>
    dc-vps 로컬라이제이션 서버(server/, /localize)를 호출해서 카메라 이미지로부터
    6DoF pose를 구하고, robot_localization EKF 입력 또는 AMCL /initialpose로 쓸 수
    있는 PoseWithCovarianceStamped를 퍼블리시하는 브리지 노드.
  </description>
  <maintainer email="ehrudxo@gmail.com">keen</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
