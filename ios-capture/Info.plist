<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  GENERATE_INFOPLIST_FILE=YES와 함께 쓰는 "추가 키" 파일. 카메라 권한 문구 같은
	  것들은 프로젝트 빌드 설정(INFOPLIST_KEY_*)에 그대로 두고, 그쪽으로 표현하기
	  애매한 키만 여기 둔다. 같은 키가 양쪽에 있으면 빌드 에러가 나므로 중복 금지.
	-->

	<!-- 서버 업로드(고급 모드)가 같은 Wi-Fi/LAN의 주소로 붙을 때 iOS 14+가 요구하는
	     로컬 네트워크 권한. 없으면 사용자에게 아무 안내 없이 연결이 조용히 실패한다. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>고급 모드에서 같은 네트워크에 있는 서버로 스캔을 업로드할 때 사용합니다</string>

	<!-- Documents/scan_<name>/ 을 Files 앱("나의 iPhone")에서 그대로 열고 옮길 수 있게
	     한다 -- 스캔 하나가 수백 MB라 사용자가 직접 관리/백업할 수단이 필요하다. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- ARKit 필수. LiDAR 자체를 나타내는 capability 키는 없어서 실행 시점에
	     UnsupportedDeviceView가 sceneDepth/sceneReconstruction 지원을 다시 확인한다. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arkit</string>
		<string>arm64</string>
	</array>
</dict>
</plist>
